# infojunta — environment variables
# Copy to .env.local and fill in. The app runs WITHOUT these (committed
# fallback data + no-op analytics); fill them in to enable live persistence
# and tracking.

# --- Supabase (public read, service-role write) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the refresh pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mixpanel (client analytics) ---
NEXT_PUBLIC_MIXPANEL_TOKEN=

# --- Refresh cron protection (optional) ---
# If set, the Vercel Cron must send this as a Bearer token.
CRON_SECRET=
