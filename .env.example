# infojunta — environment variables
# Copy to .env.local and fill in. The app runs WITHOUT these (committed
# fallback data + no-op analytics); fill them in to enable live persistence
# and tracking.

# --- Supabase (public read, service-role write) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the refresh pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mixpanel (client analytics) ---
NEXT_PUBLIC_MIXPANEL_TOKEN=

# --- Refresh cron protection (REQUIRED to enable refreshes) ---
# The /api/refresh endpoint fails closed: if this is unset, every call is 401,
# so scheduled refreshes won't run. Vercel Cron sends it as a Bearer token
# automatically once it's set in the project env.
CRON_SECRET=
